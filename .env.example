# Токен от @BotFather
BOT_TOKEN=
# ОБЯЗАТЕЛЬНО. Любая случайная строка (a-z, A-Z, 0-9, _, -), защищает вебхук; без неё он отклоняет все запросы
WEBHOOK_SECRET=
# ОБЯЗАТЕЛЬНО для ежедневного дайджеста. Любая случайная строка: Vercel сам шлёт её cron-у как Bearer-токен
CRON_SECRET=
# Публичный URL деплоя, нужен только для npm run set-webhook
PUBLIC_URL=https://your-project.vercel.app
# Upstash Redis (подставляется автоматически при подключении через Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Необязательно
CURRENCY=₽
TZ_NAME=Europe/Moscow
