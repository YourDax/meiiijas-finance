# Токен от @BotFather
BOT_TOKEN=
# Любая случайная строка (a-z, A-Z, 0-9, _, -), защищает вебхук
WEBHOOK_SECRET=
# Публичный URL деплоя, нужен только для npm run set-webhook
PUBLIC_URL=https://your-project.vercel.app
# Upstash Redis (подставляется автоматически при подключении через Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Необязательно
CURRENCY=₽
TZ_NAME=Europe/Moscow
